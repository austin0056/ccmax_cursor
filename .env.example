# ---- Upstream supplier (Anthropic protocol) ----
UPSTREAM_BASE_URL=https://api.aigclaw.ai
UPSTREAM_API_KEY=sk-your-supplier-key-here
ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_BETA=prompt-caching-2024-07-31

# ---- This proxy (distribution layer, OpenAI protocol) ----
HOST=127.0.0.1
PORT=8787
PROXY_API_KEY=
# MODEL_OVERRIDE=claude-opus-4-8
# Rebrand: clients call the DISPLAY name, upstream gets the real name (UPSTREAM=DISPLAY pairs).
# MODEL_MAP=claude-opus-4-8=max-opus-4.8,claude-sonnet-4-6=max-sonnet-4.6
# Catalog: only expose & accept these client-facing names; others get 404. Empty = all.
# MODEL_ALLOW=max-opus-4.8,max-sonnet-4.6
# Appended to the system prompt; re-asserts proactive tool use. Fixes BOTH "Plan mode 0 todos"
# and agent edits stopping early. (Avoid "MUST call todo first" wording — it hijacks agent mode.)
# SYSTEM_SUFFIX=You are operating inside an agentic coding IDE. Always carry out the user request by CALLING the tools provided in this request; never just describe what you would do in prose when a provided tool can do it. Edit code with the editing tools, and when a todo or planning tool is provided, record the plan by calling that tool. If any provided tool can perform the next step, call it instead of writing prose.

# ---- OpenAI-protocol token counting ----
TOKENIZER_ENCODING=o200k_base
# usage reporting: anthropic = match the supplier (incl. 5m/1h cache write + read); openai = tiktoken
USAGE_SOURCE=anthropic
DEFAULT_MAX_TOKENS=4096
IMAGE_TOKENS_EACH=85

# ---- Supplier cost reconciliation (USD per 1M tokens; 0 = disabled) ----
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
PRICE_CACHE_WRITE_PER_MTOK=0
PRICE_CACHE_READ_PER_MTOK=0

USAGE_LOG_PATH=usage.jsonl
# DEBUG_DUMP=1   # log request tools/tool_choice + response tool_calls (stderr + debug.jsonl)
